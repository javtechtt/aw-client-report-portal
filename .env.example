FLASK_SECRET_KEY=replace-with-a-long-random-string
APP_CONFIG=development

# Optional. Local dev defaults to sqlite:///database/portal.db.
# On Railway, point at a persistent volume, e.g.:
#   DATABASE_URL=sqlite:////data/portal.db
# DATABASE_URL=

# PORT is provided by Railway automatically; gunicorn binds to it via the
# Procfile. The Flask dev server ignores this and uses its own --port flag.
# PORT=5000
